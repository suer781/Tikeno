<?xml version="1.0" encoding="utf-8"?>
<!-- 设置页（SettingsActivity）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings_title"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_power_profile_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/settings_power_profile"
        android:textSize="15sp" />

    <RadioGroup
        android:id="@+id/rg_power_profile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/rb_power_balanced"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_power_balanced" />

        <RadioButton
            android:id="@+id/rb_power_performance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_power_performance" />

        <RadioButton
            android:id="@+id/rb_power_saver"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_power_saver" />
    </RadioGroup>

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/sw_pause_on_screen_off"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/settings_pause_on_screen_off" />

    <Button
        android:id="@+id/btn_compliance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/settings_show_compliance" />

    <TextView
        android:id="@+id/tv_version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textSize="12sp" />
</LinearLayout>