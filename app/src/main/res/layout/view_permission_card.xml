<?xml version="1.0" encoding="utf-8"?>
<!-- 权限卡片（PermissionCardBinder 宿主）：三行权限 + 摘要。id 必须与代码匹配。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_float_panel"
    android:padding="12dp">

    <TextView
        android:id="@+id/tv_permission_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/permission_missing"
        android:textStyle="bold"
        android:textSize="14sp" />

    <!-- 悬浮窗权限行 -->
    <LinearLayout
        android:id="@+id/row_overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="8dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="悬浮窗权限"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/tv_perm_state_overlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/perm_missing"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 无障碍服务行 -->
    <LinearLayout
        android:id="@+id/row_accessibility"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="8dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="无障碍服务"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/tv_perm_state_a11y"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/perm_missing"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 通知权限行 -->
    <LinearLayout
        android:id="@+id/row_notification"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="8dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="通知权限"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/tv_perm_state_notif"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/perm_missing"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>